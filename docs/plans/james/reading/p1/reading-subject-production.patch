+              FROM platform_monster_visual_config
+              WHERE id = ?
+                AND draft_revision = ?
+                AND draft_json = ?
+                AND draft_updated_at = ?
+                AND draft_updated_by_account_id = ?
+                AND last_mutation_account_id = ?
+                AND last_mutation_request_id = ?
+                AND last_mutation_request_hash = ?
+                AND last_mutation_kind = ?

-  // Step 1: optimistic insert.
-  await run(db, `
-    INSERT OR IGNORE INTO admin_kpi_metrics (metric_key, metric_count, updated_at)
-    VALUES (?, ?, ?)
-  `, [RECONCILE_LOCK_METRIC_KEY, ownerHash, ts]);

+      ? {
+          title: typeof event.toast.title === 'string' ? event.toast.title : '',
+          body: typeof event.toast.body === 'string' ? event.toast.body : '',
+        }
+      : null,
+    presentationAckKey: `reward:reward.presentation:${id}:celebration:0`,
+  };

-  if (!radio) return;
-  const group = radio.closest('[role="radiogroup"]');
-  if (!group) return;
-  const key = event.key;
-  const isNext = RADIOGROUP_KEYS_NEXT.has(key);
-  const isPrev = RADIOGROUP_KEYS_PREV.has(key);

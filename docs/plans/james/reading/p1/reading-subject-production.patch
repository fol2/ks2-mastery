-      throw new ConflictError('Another reconciliation is in progress. Retry in a minute.', {
-        code: 'reconcile_in_progress',
-        retryable: true,
-        lockedSince: existingUpdatedAt,
-        staleAfterMs: RECONCILE_LOCK_STALE_WINDOW_MS,
-      });

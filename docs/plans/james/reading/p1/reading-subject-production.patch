+    kind: 'admin.account_role.update',
+    scopeType: 'account',
+    scopeId: targetAccountId,
+    requestId,
+    correlationId,
+    previousRole: currentRole,
+    platformRole: nextRole,
+    appliedAt: nowTs,
+    replayed: false,
+    expectedRepoRevision: normalisedExpectedRepoRevision,
+    repoRevision: nextRepoRevision,

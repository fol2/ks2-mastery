-
-  const requestId = `hero-claim-${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 8)}`;
-
-  patchHeroUi({
-    status: 'claiming',
-    pendingClaimKey: taskId,
-    error: '',
-  });
-
-  try {
-    const result = await heroClient.claimTask({
-      learnerId,
-      questId,
-      questFingerprint,
-      taskId,
-      requestId,
-      practiceSessionId,
-    });
-
-    patchHeroUi({
-      status: 'ready',

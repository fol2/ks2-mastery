+  const correlationId = typeof raw.correlationId === 'string' && raw.correlationId
+    ? raw.correlationId
+    : requestId;
+  const expectedRevision = Number.isFinite(Number(raw.expectedDraftRevision))
+    ? Number(raw.expectedDraftRevision)
+    : null;

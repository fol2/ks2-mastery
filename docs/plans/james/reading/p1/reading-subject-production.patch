-        INSERT INTO admin_kpi_metrics (metric_key, metric_count, updated_at)
-        VALUES (?, ?, ?)
-        ON CONFLICT(metric_key) DO UPDATE SET
-          metric_count = excluded.metric_count,
-          updated_at = excluded.updated_at
-      `, [key, value, ts]));

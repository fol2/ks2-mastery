+
+async function readBootstrapMonsterVisualRuntimeConfig(db, nowTs) {
+  try {
+    return await readPublishedMonsterVisualRuntimeConfig(db, nowTs);
+  } catch (error) {
+    logMutation('warn', 'monster_visual_config.bootstrap_fallback', {

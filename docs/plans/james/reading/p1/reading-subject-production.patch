+  return {
+    ...cloneSerialisable(BUNDLED_MONSTER_VISUAL_CONFIG),
+    schemaVersion: MONSTER_VISUAL_SCHEMA_VERSION,
+    manifestHash: MONSTER_ASSET_MANIFEST.manifestHash,
+    source,
+    version,
+    effect: bundledEffectConfig(),
+  };

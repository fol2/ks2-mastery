+  return {
+    rows: pageRows,
+    page: {
+      limit,
+      nextCursor: hasMore && pageRows.length
+        ? encodeHistoryCursor(pageRows[pageRows.length - 1], timestampField)
+        : null,
+      hasMore,
+    },
+  };
+}

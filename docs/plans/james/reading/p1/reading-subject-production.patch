-    const takeoverResult = await run(db, `
-      UPDATE admin_kpi_metrics
-      SET metric_count = ?, updated_at = ?
-      WHERE metric_key = ? AND metric_count = ? AND updated_at = ?
-    `, [
-      ownerHash,
-      ts,
-      RECONCILE_LOCK_METRIC_KEY,
-      existingOwnerHash,
-      existingUpdatedAt,
-    ]);

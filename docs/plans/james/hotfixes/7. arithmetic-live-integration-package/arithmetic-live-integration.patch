+export function recordArithmeticRewardUnitMastery({
+  learnerId,
+  rewardUnitId,
+  releaseId = ARITHMETIC_REWARD_RELEASE_ID,
+  masteryKey = arithmeticMasteryKey(rewardUnitId, releaseId),
+  gameStateRepository,
+  random = Math.random,

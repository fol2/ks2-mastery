+    postMegaSeed: {
+      learnerId,
+      shapeName,
+      today: todayDay,
+      createdLearner,
+      dataKeys: Object.keys(data).sort(),
+      // U3 reviewer follow-up (HIGH adversarial): capture pre-image so a

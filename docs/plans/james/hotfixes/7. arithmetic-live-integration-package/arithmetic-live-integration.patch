+    status: 'loading',
+    learnerId,
+    requestToken,
+    error: '',
+  });
+
+  try {
+    const response = await heroClient.readModel({ learnerId });
+
+    // Stale token guard — learner changed while request was in-flight.
+    if (heroUi.requestToken !== requestToken) return;
+

+  ARITHMETIC_REWARD_UNITS.reduce((totals, unit) => {
+    const monsterId = ARITHMETIC_STRAND_TO_MONSTER[unit.strand];
+    if (monsterId) totals[monsterId] = (totals[monsterId] || 0) + 1;
+    totals[ARITHMETIC_GRAND_MONSTER_ID] = (totals[ARITHMETIC_GRAND_MONSTER_ID] || 0) + 1;

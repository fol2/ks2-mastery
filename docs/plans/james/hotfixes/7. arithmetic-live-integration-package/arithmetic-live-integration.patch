+  const mastered = masteredList(entry);
+  if (mastered.length) return arithmeticMasteredList(entry, releaseId).length;
+  const count = Number(entry?.masteredCount);
+  return Number.isFinite(count) && count > 0 ? Math.floor(count) : 0;

+      scopeType: 'learner',
+      scopeId: command.learnerId,
+      requestId: nextMutation.requestId,
+      correlationId: nextMutation.correlationId,
+      expectedRevision: originalExpectedRevision,
+      appliedRevision: firstAttempt.appliedRevision,
+    });

+async function readReconcileLockRow(db) {
+  return first(db, `
+    SELECT metric_key, metric_count, updated_at
+    FROM admin_kpi_metrics
+    WHERE metric_key = ?
+  `, [RECONCILE_LOCK_METRIC_KEY]);
+}

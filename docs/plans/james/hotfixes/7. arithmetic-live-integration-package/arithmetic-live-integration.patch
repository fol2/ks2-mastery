+    policyVersion: MUTATION_POLICY_VERSION,
+    kind: POST_MEGA_SEED_MUTATION_KIND,
+    scopeType: 'platform',
+    scopeId,
+    requestId,
+    correlationId,
+    appliedAt: ts,
+    replayed: false,
+  };

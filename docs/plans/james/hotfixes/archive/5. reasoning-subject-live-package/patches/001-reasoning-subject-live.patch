+      ...workingState,
+      [monsterId]: {
+        ...entry,
+        caught: true,
+        releaseId,
+        mastered: nextMastered,
+        starHighWater,
+        displayStars: starHighWater,
+        starMax: 100,
+        ...(monsterId === REASONING_GRAND_MONSTER_ID ? { grandStars: starHighWater, grandStarMax: 100 } : {}),
+      },
+    };

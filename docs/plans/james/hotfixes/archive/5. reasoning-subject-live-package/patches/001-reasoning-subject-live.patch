+            if (start === arr.length) {
+              allPerms.push(Number(arr.join("")));
+              return;
+            }
+            for (let i = start; i < arr.length; i++) {
+              [arr[start], arr[i]] = [arr[i], arr[start]];
+              permute(arr, start+1);
+              [arr[start], arr[i]] = [arr[i], arr[start]];
+            }
+          }
+          permute(digits.slice());

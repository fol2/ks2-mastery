+    snapshot.displayStars = Math.max(0, Math.floor(Number(raw.displayStars ?? raw.stars ?? raw.starHighWater) || 0));
+  }
+  if ('displayStage' in raw) {
+    snapshot.displayStage = Math.max(0, Math.min(5, Math.floor(Number(raw.displayStage) || 0)));

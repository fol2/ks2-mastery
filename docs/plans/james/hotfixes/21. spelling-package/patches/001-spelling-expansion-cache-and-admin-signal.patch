+test('worker admin content-quality signals report spelling runtime word coverage from persisted content', async () => {
+  const server = createWorkerRepositoryServer();
+  try {
+    const initialResponse = await fetchAdmin(server, 'https://repo.test/api/content/spelling');
+    const initial = await initialResponse.json();
+
+    const writeResponse = await fetchAdmin(server, 'https://repo.test/api/content/spelling', {
+      method: 'PUT',
+      headers: { 'content-type': 'application/json' },
+      body: JSON.stringify({
+        content: SEEDED_SPELLING_CONTENT_BUNDLE,
+        mutation: {
+          requestId: 'content-quality-spelling-coverage-1',
+          correlationId: 'content-quality-spelling-coverage-1',
+          expectedAccountRevision: initial.mutation.accountRevision,
+        },
+      }),
+    });
+    assert.equal(writeResponse.status, 200);
+
+    const response = await fetchAdmin(server, 'https://repo.test/api/admin/ops/content-quality-signals');
+    const payload = await response.json();
+    const spelling = payload.subjects.find((subject) => subject.subjectKey === 'spelling');
+    const expectedRuntimeWords = SEEDED_SPELLING_CONTENT_BUNDLE.releases.at(-1).snapshot.words.length;
+
+    assert.equal(response.status, 200);
+    assert.equal(spelling.signals.itemCoverage.status, 'available');
+    assert.equal(spelling.signals.itemCoverage.value, expectedRuntimeWords);
+    assert.equal(spelling.signals.itemCoverage.total, expectedRuntimeWords);
+  } finally {
+    server.close();
+  }
+});

+    for (const match of matches) {
+      findings.push({
+        itemId: item.id,
+        familyId: item.generatorFamilyId || '',
+        mode: item.mode || '',
+        skillIds: item.skillIds || [],
+        [phraseKey]: match,
+        model: item.model || '',
+      });
+    }
+  }
+  return findings.slice(0, 100);
+}

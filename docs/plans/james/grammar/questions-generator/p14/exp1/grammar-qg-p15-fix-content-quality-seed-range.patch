 const DEFAULT_SEEDS = Object.freeze([1, 2, 3]);
+
+/**
+ * Parse a seed argument into a non-empty sorted list of positive integers.
+ * Supports comma lists ("1,2,3") and inclusive ranges ("1..30").
+ * This prevents a silent zero-check audit when callers pass --seeds=1..30.
+ */
+export function parseSeedList(value) {
+  if (!value) return [...DEFAULT_SEEDS];
+  const out = [];
+  for (const part of String(value).split(',')) {
+    const text = part.trim();
+    if (!text) continue;
+    const range = text.match(/^(\d+)\.\.(\d+)$/);
+    if (range) {
+      const start = Number(range[1]);
+      const end = Number(range[2]);
+      if (!Number.isInteger(start) || !Number.isInteger(end) || start < 1 || end < start) {
+        throw new Error(`Invalid seed range: ${text}`);
+      }
+      for (let seed = start; seed <= end; seed += 1) out.push(seed);
+      continue;
+    }
+    const seed = Number(text);
+    if (!Number.isInteger(seed) || seed < 1) {
+      throw new Error(`Invalid seed value: ${text}`);
+    }
+    out.push(seed);
+  }
+  const unique = Array.from(new Set(out)).sort((a, b) => a - b);
+  if (!unique.length) throw new Error(`No valid seeds parsed from: ${value}`);
+  return unique;
+}

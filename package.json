    "verify:punctuation-qg:p13-predeploy": "node scripts/verify-punctuation-qg-p13-predeploy.mjs",
    "smoke:production:punctuation:p13": "node scripts/punctuation-qg-p13-live-smoke.mjs --env production --authenticated --out reports/punctuation/punctuation-qg-p13-production-smoke.json",
    "verify:punctuation-qg:p13-live": "node scripts/validate-punctuation-qg-p13-live-evidence.mjs reports/punctuation/punctuation-qg-p13-production-smoke.json",
